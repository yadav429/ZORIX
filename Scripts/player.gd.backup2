extends CharacterBody3D

@export var speed: float = 6.0
@export var sprint_speed: float = 10.0
@export var jump_force: float = 5.0
@export var gravity: float = 15.0
@export var mouse_sensitivity: float = 0.005

var mobile_input := Vector2.ZERO
var is_sprinting := false

var camera_pivot: Node3D
var spring_arm: SpringArm3D

func _ready():
    add_to_group("player")

    camera_pivot = Node3D.new()
    camera_pivot.position = Vector3(0, 1.5, 0)
    add_child(camera_pivot)

    spring_arm = SpringArm3D.new()
    spring_arm.spring_length = 5.0
    spring_arm.collision_mask = 1
    camera_pivot.add_child(spring_arm)

    var camera = Camera3D.new()
    spring_arm.add_child(camera)
    camera.current = true

func set_mobile_move(value: Vector2):
    mobile_input = value

func set_sprinting(value: bool):
    is_sprinting = value

func jump():
    if is_on_floor():
        velocity.y = jump_force

func rotate_camera(horizontal: float, vertical: float):
    camera_pivot.rotation.y -= horizontal * mouse_sensitivity
    camera_pivot.rotation.x -= vertical * mouse_sensitivity

    camera_pivot.rotation.x = clamp(
        camera_pivot.rotation.x,
        deg_to_rad(-60),
        deg_to_rad(60)
    )

func _physics_process(delta):
    if not is_on_floor():
        velocity.y -= gravity * delta

    var keyboard = Input.get_vector(
        "ui_left", "ui_right", "ui_up", "ui_down"
    )

    var input_dir = (mobile_input + keyboard).limit_length(1.0)

    var basis = camera_pivot.global_transform.basis
    var direction = (
        basis * Vector3(input_dir.x, 0, input_dir.y)
    ).normalized()

    if direction.length() > 0.01:
        var target_angle = atan2(-direction.x, -direction.z)
        rotation.y = lerp_angle(
            rotation.y,
            target_angle,
            min(delta * 8.0, 1.0)
        )

    var current_speed = sprint_speed if is_sprinting else speed

    velocity.x = direction.x * current_speed
    velocity.z = direction.z * current_speed

    if Input.is_action_just_pressed("ui_accept"):
        jump()

    move_and_slide()
