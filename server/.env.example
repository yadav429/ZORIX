# Copy to server/.env and fill these values. Never commit your real secret.
# Generate separate 32+ character secrets with: openssl rand -hex 32
ZORIX_JWT_SECRET=replace-with-random-64-hex-characters
ZORIX_SERVER_SECRET=replace-with-random-64-hex-characters
ZORIX_JOIN_TICKET_SECRET=replace-with-another-random-64-hex-characters
ZORIX_API_URL=https://zorix-player-api-dnz5.onrender.com
ZORIX_PUBLIC_HOST=YOUR_VPS_PUBLIC_IP
ZORIX_SERVER_REGION=india
ZORIX_SERVER_NAME=zorix-br-india
ZORIX_MIN_MATCH_PLAYERS=2
ZORIX_GAME_HOST=YOUR_VPS_PUBLIC_IP
ZORIX_GAME_PORT=24560
ZORIX_GAME_MODE=battle_royale
ZORIX_MAX_PLAYERS=50
PORT=24560
MAX_PLAYERS=50
GAME_MODE=battle_royale
AUTH_PORT=8080
SERVER_BINARY=build/zorix-server.x86_64
